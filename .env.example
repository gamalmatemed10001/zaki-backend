# Copy to .env and fill in. Never commit .env (spec §8).

# Personal endpoint token. Single-user system — generate any long random string.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ZAKI_API_KEY=

# Google AI Studio key for Gemini (the default / cheap route)
GOOGLE_API_KEY=

# Anthropic key for Claude (the escalation route)
ANTHROPIC_API_KEY=

# --- Optional overrides -------------------------------------------------
# Model IDs are settings, not literals, so a vendor rename is an env change
# rather than a code edit. Verify against vendor docs before changing.
# ZAKI_GEMINI_MODEL=gemini-3.5-flash
# ZAKI_CLAUDE_MODEL=claude-sonnet-5

# Gemini falls back to this model on a 429 (quota) or 503 (overloaded)
# error from ZAKI_GEMINI_MODEL — a distinct model so a per-model quota
# limit doesn't also block the fallback. gemini-1.5-flash/-pro are NOT
# valid choices here — both are fully shut down (404), confirmed live
# against the API at build time.
# ZAKI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude reasoning depth: low | medium | high | xhigh | max
# Higher = better analysis, slower reply. Voice favours lower.
# ZAKI_CLAUDE_EFFORT=medium

# Characters of input above which a request escalates to Claude
# ZAKI_ESCALATION_LENGTH=280

# --- Google OAuth (step 2 — Calendar / Gmail / Drive tools) -------------
# From Google Cloud Console: create an OAuth 2.0 Client ID (Web
# application), enable the Calendar, Gmail, and Drive APIs, and add the
# redirect URI below to the client's "Authorized redirect URIs".
# App works fine without these set — Google tools just won't appear.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Postgres / Supabase (step 3 — tasks, notes, context, tokens) -------
# From a Supabase project: Project Settings -> Database -> Connection string.
# DATABASE_URL: pgbouncer transaction-mode pooler (port 6543) — app runtime.
# DIRECT_URL: session-mode pooler or direct connection (port 5432) — migrations only.
# The literal "[YOUR-PASSWORD]" in Supabase's own UI is a placeholder — swap
# in your actual DB password with NO surrounding brackets.
DATABASE_URL=
DIRECT_URL=

# Personal Access Token for the Supabase MCP server (lets Claude manage the
# project directly — create tables, run SQL). NOT read by the app itself;
# only used by .mcp.json's stdio server config. Supabase Dashboard -> your
# account icon -> Access Tokens -> Generate new token.
SUPABASE_ACCESS_TOKEN=

# Web search (step 4): no env var needed — ddgs (DuckDuckGo) requires no API key.

# --- Speech-to-text (step 5 — Windows client audio input) ---------------
# From platform.openai.com/api-keys. App works fine without this; the
# audio endpoint just returns a clear "not configured" error until it's set.
OPENAI_API_KEY=
# ZAKI_STT_MODEL=gpt-4o-transcribe

# Cheap cross-vendor fallback tier in pipeline.py's cascade (Gemini ->
# this -> Claude) — used only once Gemini has already failed. Skipped
# entirely if OPENAI_API_KEY above isn't set.
# ZAKI_OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Text-to-speech (step 7): no env var needed — edge-tts (Microsoft Edge's
# free online TTS) requires no API key or account. Default voice is
# ar-SA-HamedNeural (Modern Standard Arabic, male, matches the system
# prompt's فصحى register). Other good MSA-quality options:
# ZAKI_TTS_VOICE=ar-AE-HamdanNeural   # UAE, male
# ZAKI_TTS_VOICE=ar-EG-SalmaNeural    # Egyptian, female (dialect-flavored)

# --- WhatsApp via Evolution API (self-hosted WhatsApp gateway) -----------
# App works fine without these set — the WhatsApp tools/webhook just
# return a clear "not configured" error until they're set.
# EVOLUTION_API_URL: base URL of your running Evolution API instance.
# EVOLUTION_API_KEY: the instance's global or per-instance API key.
# EVOLUTION_INSTANCE_NAME: the WhatsApp instance name you created in Evolution API.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# A secret YOU generate (e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`)
# and put in the Evolution API webhook URL as a query param when
# configuring it to call this backend:
#   {ZAKI_PUBLIC_BASE_URL}/api/webhooks/whatsapp?token=<this value>
# Evolution's own webhook call carries no Zaki-specific auth otherwise.
WHATSAPP_WEBHOOK_TOKEN=

# --- Phone calls via Twilio ----------------------------------------------
# From the Twilio Console. App works fine without these set — the call
# tools just return a clear "not configured" error until they're set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Publicly reachable base URL for THIS backend (e.g. an ngrok/cloudflared
# tunnel in local dev, or the real deployed URL) — Twilio must be able to
# fetch TwiML from /api/webhooks/twilio/voice and open a WebSocket to
# /api/webhooks/twilio/voice/stream over the public internet; 127.0.0.1
# does not work here. Also used as the WhatsApp webhook's base when you
# configure Evolution API's webhook URL above.
# ZAKI_PUBLIC_BASE_URL=https://your-tunnel-or-domain.example

# The Twilio Media Streams audio bridge (telephony.py) shells out to the
# `ffmpeg` binary to convert edge-tts's MP3 output to the 8kHz mono PCM
# Twilio expects — install ffmpeg and make sure it's on PATH, or outbound
# call audio will fail even though everything above is configured.

# --- Telegram bot ---------------------------------------------------------
# From @BotFather. TELEGRAM_ALLOWED_USER_ID locks the bot to one Telegram
# user id (get yours from @userinfobot) — every other user's messages are
# silently ignored, no reply at all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Only used in webhook mode (requires ZAKI_PUBLIC_BASE_URL above to be a
# real https:// address — Telegram rejects http/localhost outright). Set
# automatically via setWebhook at startup when both are present; leave
# ZAKI_PUBLIC_BASE_URL unset (or http://) to run in long-polling mode
# instead, which needs neither this secret nor any public URL.
TELEGRAM_WEBHOOK_SECRET=

# --- Reminders / daily briefing persistence -------------------------------
# SQLite file backing APScheduler's persistent job store — without this,
# a reminder set via Telegram is lost if the backend restarts before it
# fires. Defaults to data/reminders.db (relative to CWD) if unset, so a
# from-scratch checkout works with zero config.
# ZAKI_REMINDERS_DB_PATH=Y:/zaki/data/reminders.db

# Overrides ZAKI_REMINDERS_DB_PATH entirely with a full Postgres URL when
# set — required for persistence on Render's free tier, which has no
# persistent disk at all (see render.yaml). The same Supabase DIRECT_URL
# above works fine; scheduler.py isolates its tables into their own
# "zaki_scheduler" schema, same pattern as Evolution API's own schema.
# ZAKI_REMINDERS_DB_URL=postgresql+psycopg2://user:pass@host:5432/postgres

# --- Disk hygiene ----------------------------------------------------------
# Optional. When set, Python's tempfile module (and anything built on it,
# e.g. Starlette's UploadFile spilling large uploads to disk) writes here
# instead of the OS default temp dir — set this if your system drive is
# constrained and you have a roomier secondary drive. No effect on Linux/
# Vercel deployments where this isn't set.
# Use forward slashes even on Windows — a double-quoted backslash path in
# .env is parsed for escape sequences (e.g. \t becomes a literal tab), a
# real trap that bit this exact setting during setup.
# ZAKI_TEMP_DIR=Y:/zaki/temp
