# Copy to .env in this windows_client/ folder and fill in.
# This is a SEPARATE .env from the backend's — this app is a separate
# deployable (a desktop process, not a serverless function).

# Same personal endpoint token as the backend's ZAKI_API_KEY.
ZAKI_API_KEY=

# --- Optional overrides -------------------------------------------------
# ZAKI_BACKEND_URL=http://127.0.0.1:8000
# ZAKI_HOTKEY=ctrl+shift+z
# ZAKI_SESSION_ID=windows-client
